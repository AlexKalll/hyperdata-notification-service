# ==============================================
# SERVER CONFIGURATION
# ==============================================

# Port on which the application will run
# Default: 3002 (3000 is used by the backend API, 3001 by the frontend)
PORT=3002

# Node environment (development, production, test)
NODE_ENV=development

# ==============================================
# DATABASE CONFIGURATION (PostgreSQL)
# ==============================================

# PostgreSQL database host
DB_HOST=localhost

# PostgreSQL database port
# Default: 5432
DB_PORT=5432

# PostgreSQL database username
DB_USERNAME=postgres

# PostgreSQL database password
DB_PASSWORD=postgres

# PostgreSQL database name
DB_DATABASE=notifications

# TypeORM connection URL used by the service
# Use `postgres` when the service runs on the backend Docker network,
# or `localhost` when PostgreSQL is published to the host.
DB_URL=postgresql://postgres:postgres@localhost:5432/notifications

# PostgreSQL schema used by TypeORM
DATABASE_SCHEMA=public

# ==============================================
# RABBITMQ CONFIGURATION
# ==============================================

# RabbitMQ server host
RABBITMQ_HOST=localhost

# RabbitMQ server port
# Default: 5672
RABBITMQ_PORT=5672

# RabbitMQ username
RABBITMQ_USERNAME=guest

# RabbitMQ password
RABBITMQ_PASSWORD=guest

# RabbitMQ queue name for consuming notification events
RABBITMQ_QUEUE=notifications.queue

# RabbitMQ exchange name
RABBITMQ_EXCHANGE=notifications.exchange

# RabbitMQ routing key for notification events
RABBITMQ_ROUTING_KEY=notification.created

# ==============================================
# JWT AUTHENTICATION
# ==============================================

# JWT secret key (MUST match the secret used by Spring Boot backend)
# This is used to validate JWT tokens from the Spring Boot application
# IMPORTANT: Use a strong, random secret in production
JWT_SECRET=your-shared-secret-with-spring-boot

# ==============================================
# CORS CONFIGURATION
# ==============================================

# Allowed CORS origin(s) for API requests
# Use comma-separated values for multiple origins
# Example: http://localhost:4200,http://localhost:3001
CORS_ORIGIN=http://localhost:4200

# ==============================================
# LOGGING CONFIGURATION
# ==============================================

# Log level (error, warn, info, debug, verbose)
# Default: info
LOG_LEVEL=info

# ==============================================
# ONESIGNAL PUSH NOTIFICATIONS
# ==============================================

# OneSignal App ID
ONESIGNAL_APP_ID=onesignal-app-id

# OneSignal REST API Key (get from OneSignal dashboard)
ONESIGNAL_REST_API_KEY=onesignal_rest_api_key
